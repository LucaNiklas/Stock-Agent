# Kopie als .env anlegen und ausfüllen. .env wird nie committet und ist für Claude gesperrt.

# Pflicht ab Bauschritt 2: Die SEC verlangt Name und E-Mail im User-Agent.
SEC_USER_AGENT="Vorname Nachname email@beispiel.de"

# Optional, nur nach Entscheidung für einen Datenanbieter (SPEC 19 Nr. 1, spätestens Schritt 4).
DATA_VENDOR_API_KEY=

# Nicht nötig: Die Agenten laufen über das Claude-Abo, nicht über einen API-Schlüssel (SPEC 15.1).
